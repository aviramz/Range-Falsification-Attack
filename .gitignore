# Byte-compiled / cache
__pycache__/
*.pyc

# Regeneratable plot output -- run simulate.py / compare_n.py to reproduce
# from the fixed seed (RNG_SEED in simulate.py). Keep this ignored so the
# repo doesn't accumulate binary diffs every time a parameter changes.
outputs/**/*.png
outputs/**/*.gif
outputs/**/*.mp4

# Keep summary text files (small, human-readable, useful in diffs/PRs)
!outputs/**/summary.txt
!outputs/comparison_summary.txt

# OS/editor cruft
.DS_Store
*.swp

# Local virtual environment
venv/
